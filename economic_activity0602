    <!-- Firebase & Logic Script -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, onSnapshot, doc, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        window.customAlert = function(msg) {
            document.getElementById('customAlertMessage').innerHTML = msg;
            document.getElementById('customAlertModal').classList.remove('hidden');
        };

        window.customConfirm = function(msg, onConfirm) {
            document.getElementById('customConfirmMessage').innerText = msg;
            document.getElementById('customConfirmModal').classList.remove('hidden');
            const okBtn = document.getElementById('customConfirmOkBtn');
            okBtn.onclick = function() {
                window.closeConfirmModal();
                onConfirm();
            };
        };
        window.closeConfirmModal = function() { document.getElementById('customConfirmModal').classList.add('hidden'); };

        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "AIzaSyCeNSsaTytFGJMkrBA1j0zeuQxDOwDCIBk",
            authDomain: "bora-worksheet.firebaseapp.com",
            projectId: "bora-worksheet",
            storageBucket: "bora-worksheet.firebasestorage.app",
            messagingSenderId: "1091782933629",
            appId: "1:1091782933629:web:342b5a6c6cf49c55c90514"
        };
        
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        
        const initAuth = async () => {
            try { 
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth); 
                }
            } catch(e) { console.error("인증 에러:", e); }
        };
        initAuth();

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'social-rational-choice-v1'; 
        const COLLECTION_NAME = 'social_rational_choice_results'; 
        let allResults = [];

        window.appData = {
            quizScore: 0,
            isGraded: false,
            food_choice: '',
            modes: { exp_regret: 'text', exp_satisfy: 'text', reason: 'text' }
        };

        /* --- 그리기(캔버스) 로직 --- */
        window.pads = {};
        function initDrawing(canvasId, fieldId) {
            const canvas = document.getElementById(canvasId);
            const ctx = canvas.getContext('2d');
            let isDrawing = false;
            let currentTool = 'pen'; 

            function getPos(e) {
                const rect = canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return {
                    x: (clientX - rect.left) * (canvas.width / rect.width),
                    y: (clientY - rect.top) * (canvas.height / rect.height)
                };
            }

            function start(e) {
                e.preventDefault(); 
                isDrawing = true;
                const pos = getPos(e);
                ctx.beginPath();
                ctx.globalCompositeOperation = currentTool === 'eraser' ? 'destination-out' : 'source-over';
                ctx.lineWidth = currentTool === 'eraser' ? 30 : 4; 
                ctx.arc(pos.x, pos.y, ctx.lineWidth / 2, 0, Math.PI * 2);
                if(currentTool === 'pen') ctx.fillStyle = '#1f2937'; else ctx.fillStyle = 'rgba(0,0,0,1)';
                ctx.fill();
                ctx.beginPath();
                ctx.moveTo(pos.x, pos.y);
            }
            
            function move(e) {
                if(!isDrawing) return;
                e.preventDefault();
                const pos = getPos(e);
                ctx.lineTo(pos.x, pos.y);
                ctx.globalCompositeOperation = currentTool === 'eraser' ? 'destination-out' : 'source-over';
                ctx.strokeStyle = currentTool === 'eraser' ? 'rgba(0,0,0,1)' : '#1f2937';
                ctx.lineWidth = currentTool === 'eraser' ? 30 : 4;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(pos.x, pos.y);
            }

            function stop(e) {
                if(!isDrawing) return;
                e.preventDefault();
                isDrawing = false;
                window.saveLocal();
            }

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            canvas.addEventListener('mouseup', stop);
            canvas.addEventListener('mouseout', stop);
            canvas.addEventListener('touchstart', start, {passive: false});
            canvas.addEventListener('touchmove', move, {passive: false});
            canvas.addEventListener('touchend', stop, {passive: false});
            canvas.addEventListener('touchcancel', stop, {passive: false});
            
            return {
                clear: () => { ctx.clearRect(0,0,canvas.width,canvas.height); window.saveLocal(); },
                toDataURL: () => canvas.toDataURL('image/png'),
                loadFromDataURL: (dataUrl) => {
                    if(!dataUrl) return;
                    const img = new Image();
                    img.onload = () => {
                        ctx.clearRect(0,0,canvas.width,canvas.height);
                        ctx.globalCompositeOperation = 'source-over';
                        ctx.drawImage(img, 0, 0);
                    };
                    img.src = dataUrl;
                },
                setTool: (tool) => {
                    currentTool = tool;
                    const btnPen = document.getElementById(`btn_tool_pen_${fieldId}`);
                    const btnEraser = document.getElementById(`btn_tool_eraser_${fieldId}`);
                    if (btnPen && btnEraser) {
                        if (tool === 'pen') {
                            btnPen.classList.replace('text-gray-500', 'text-amber-700');
                            btnPen.classList.replace('hover:text-gray-800', 'bg-white');
                            btnPen.classList.add('shadow-sm');
                            btnEraser.classList.replace('text-amber-700', 'text-gray-500');
                            btnEraser.classList.replace('bg-white', 'hover:text-gray-800');
                            btnEraser.classList.remove('shadow-sm');
                        } else {
                            btnEraser.classList.replace('text-gray-500', 'text-amber-700');
                            btnEraser.classList.replace('hover:text-gray-800', 'bg-white');
                            btnEraser.classList.add('shadow-sm');
                            btnPen.classList.replace('text-amber-700', 'text-gray-500');
                            btnPen.classList.replace('bg-white', 'hover:text-gray-800');
                            btnPen.classList.remove('shadow-sm');
                        }
                    }
                }
            };
        }

        window.addEventListener('load', () => {
            window.pads['exp_regret'] = initDrawing('canvas_exp_regret', 'exp_regret');
            window.pads['exp_satisfy'] = initDrawing('canvas_exp_satisfy', 'exp_satisfy');
            window.pads['reason'] = initDrawing('canvas_reason', 'reason');
            window.loadLocal();
        });

        window.setMode = function(field, mode) {
            window.appData.modes[field] = mode;
            const txt = document.getElementById(field);
            const cvs = document.getElementById('canvas_' + field);
            const btnText = document.getElementById('btn_text_' + field);
            const btnDraw = document.getElementById('btn_draw_' + field);
            const toolbar = document.getElementById('toolbar_' + field);

            if(mode === 'text') {
                txt.classList.remove('hidden'); cvs.classList.add('hidden');
                btnText.classList.replace('text-gray-500', 'text-blue-600');
                btnText.classList.replace('hover:text-gray-800', 'bg-white'); btnText.classList.add('shadow-sm');
                btnDraw.classList.replace('text-blue-600', 'text-gray-500');
                btnDraw.classList.replace('bg-white', 'hover:text-gray-800'); btnDraw.classList.remove('shadow-sm');
                if (toolbar) { toolbar.classList.add('hidden'); toolbar.classList.remove('flex'); }
            } else {
                txt.classList.add('hidden'); cvs.classList.remove('hidden');
                btnDraw.classList.replace('text-gray-500', 'text-blue-600');
                btnDraw.classList.replace('hover:text-gray-800', 'bg-white'); btnDraw.classList.add('shadow-sm');
                btnText.classList.replace('text-blue-600', 'text-gray-500');
                btnText.classList.replace('bg-white', 'hover:text-gray-800'); btnText.classList.remove('shadow-sm');
                if (toolbar) { toolbar.classList.remove('hidden'); toolbar.classList.add('flex'); }
                window.pads[field].setTool('pen');
                window.dispatchEvent(new Event('resize')); 
            }
            window.saveLocal();
        };

        window.selectFood = function(foodName) {
            window.appData.food_choice = foodName;
            const cards = document.querySelectorAll('.food-card');
            cards.forEach(c => {
                if(c.innerText.includes(foodName)) {
                    c.classList.add('selected');
                } else {
                    c.classList.remove('selected');
                }
            });
            window.saveLocal();
        };

        window.gradeQuiz = function() {
            const check = (id, val, corrects) => {
                const inputEl = document.getElementById(id);
                const markEl = document.getElementById('mark' + id.replace('q', ''));
                if (corrects.includes(val)) {
                    inputEl.classList.remove('wrong'); inputEl.classList.add('correct');
                    markEl.innerHTML = '<i class="fa-solid fa-circle-check text-blue-500 text-xl"></i>';
                    return 1;
                } else {
                    inputEl.classList.remove('correct'); inputEl.classList.add('wrong');
                    markEl.innerHTML = '<i class="fa-solid fa-xmark text-red-500 text-xl"></i>';
                    return 0;
                }
            };
            
            let score = 0;
            score += check('q1', document.getElementById('q1').value.replace(/\s+/g, ''), ['가격']);
            score += check('q2', document.getElementById('q2').value.replace(/\s+/g, ''), ['품질']);
            score += check('q3', document.getElementById('q3').value.replace(/\s+/g, ''), ['디자인']);
            score += check('q4', document.getElementById('q4').value.replace(/\s+/g, ''), ['합리적']);
            
            score += check('q5', document.getElementById('q5').value.trim().toUpperCase(), ['O', 'ㅇ']);
            score += check('q6', document.getElementById('q6').value.trim().toUpperCase(), ['X', 'x']);
            score += check('q7', document.getElementById('q7').value.trim().toUpperCase(), ['O', 'ㅇ']);

            window.appData.quizScore = score;
            window.appData.isGraded = true;
            document.getElementById('quizScoreDisplay').innerText = `${score} / 7점`;
            document.getElementById('quizScoreDisplay').classList.remove('hidden');
            window.saveLocal();
        };

        window.saveLocal = function() {
            const dataToSave = {
                grade: document.getElementById('grade').value,
                classNum: document.getElementById('classNum').value,
                studentNum: document.getElementById('studentNum').value,
                studentName: document.getElementById('studentName').value,
                q1: document.getElementById('q1').value,
                q2: document.getElementById('q2').value,
                q3: document.getElementById('q3').value,
                q4: document.getElementById('q4').value,
                q5: document.getElementById('q5').value,
                q6: document.getElementById('q6').value,
                q7: document.getElementById('q7').value,
                exp_regret: document.getElementById('exp_regret').value,
                canvas_exp_regret: window.pads['exp_regret']?.toDataURL(),
                exp_satisfy: document.getElementById('exp_satisfy').value,
                canvas_exp_satisfy: window.pads['exp_satisfy']?.toDataURL(),
                reason: document.getElementById('reason').value,
                canvas_reason: window.pads['reason']?.toDataURL(),
                appData: window.appData
            };
            localStorage.setItem('socialChoiceData', JSON.stringify(dataToSave));
            
            const indicator = document.getElementById('saveIndicator');
            indicator.style.opacity = 1;
            clearTimeout(window.saveTimeout);
            window.saveTimeout = setTimeout(() => { indicator.style.opacity = 0; }, 2000);
        };

        window.loadLocal = function() {
            const saved = localStorage.getItem('socialChoiceData');
            if(saved) {
                try {
                    const data = JSON.parse(saved);
                    ['grade', 'classNum', 'studentNum', 'studentName', 'q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'exp_regret', 'exp_satisfy', 'reason'].forEach(f => { 
                        if(data[f] !== undefined) document.getElementById(f).value = data[f]; 
                    });
                    
                    if(data.appData) {
                        window.appData.quizScore = data.appData.quizScore;
                        window.appData.isGraded = data.appData.isGraded;
                        window.appData.food_choice = data.appData.food_choice;
                        if(data.appData.modes) window.appData.modes = data.appData.modes;
                        
                        if(window.appData.food_choice) {
                            window.selectFood(window.appData.food_choice);
                        }
                        if(window.appData.isGraded) window.gradeQuiz(); 
                    }
                    
                    if(data.canvas_exp_regret) window.pads['exp_regret'].loadFromDataURL(data.canvas_exp_regret);
                    if(data.canvas_exp_satisfy) window.pads['exp_satisfy'].loadFromDataURL(data.canvas_exp_satisfy);
                    if(data.canvas_reason) window.pads['reason'].loadFromDataURL(data.canvas_reason);

                    ['exp_regret', 'exp_satisfy', 'reason'].forEach(f => window.setMode(f, window.appData.modes[f]));
                } catch(e) {}
            } else {
                ['exp_regret', 'exp_satisfy', 'reason'].forEach(f => window.setMode(f, 'text'));
            }
        };

        window.submitAll = async function() {
            const studentName = document.getElementById('studentName').value.trim();
            const classNum = document.getElementById('classNum').value;
            const studentNum = document.getElementById('studentNum').value;

            if(!studentName || !classNum || !studentNum) return window.customAlert("반, 번호, 이름을 정확히 적어주세요!");
            if(!window.appData.food_choice) return window.customAlert("2번 활동에서 자신이 먹고 싶은 음식을 선택해주세요!");
            if(!window.appData.isGraded) return window.customAlert("3번 활동의 '정답 확인하기' 버튼을 눌러주세요!");
            if (!auth.currentUser) return window.customAlert("서버 연결 대기중입니다. 잠시 후 시도해주세요.");

            try {
                const getFinalData = (field) => window.appData.modes[field] === 'text' ? document.getElementById(field).value : window.pads[field].toDataURL();

                const resultsRef = collection(db, 'artifacts', appId, 'public', 'data', COLLECTION_NAME);
                await addDoc(resultsRef, {
                    grade: document.getElementById('grade').value,
                    classNum: classNum,
                    studentNum: studentNum,
                    studentName: studentName,
                    exp_regret_mode: window.appData.modes['exp_regret'],
                    exp_regret: getFinalData('exp_regret'),
                    exp_satisfy_mode: window.appData.modes['exp_satisfy'],
                    exp_satisfy: getFinalData('exp_satisfy'),
                    food_choice: window.appData.food_choice,
                    reason_mode: window.appData.modes['reason'],
                    reason: getFinalData('reason'),
                    quizScore: window.appData.quizScore,
                    timestamp: new Date().toISOString()
                });
                
                localStorage.removeItem('socialChoiceData');
                document.getElementById('resultModal').classList.remove('hidden');
            } catch (e) { 
                window.customAlert("저장 중 오류가 발생했습니다. 인터넷 연결을 확인해주세요.");
            }
        };

        window.deleteSubmission = function(docId) {
            window.customConfirm("이 학생의 결과물을 정말 삭제하시겠습니까?\n(삭제된 데이터는 복구할 수 없습니다.)", async () => {
                if (!auth.currentUser) return;
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', COLLECTION_NAME, docId);
                    await deleteDoc(docRef);
                } catch (e) {
                    console.error("삭제 중 오류:", e);
                    window.customAlert("삭제 중 오류가 발생했습니다.");
                }
            });
        };

        const TEACHER_PASSWORD = "0402"; 
        window.openPasswordModal = function() {
            document.getElementById('passwordModal').classList.remove('hidden');
            document.getElementById('passwordError').classList.add('hidden');
            document.getElementById('teacherPasswordInput').value = '';
            setTimeout(() => document.getElementById('teacherPasswordInput').focus(), 100);
        };
        window.closePasswordModal = function() { document.getElementById('passwordModal').classList.add('hidden'); };
        window.checkPassword = function() {
            if (document.getElementById('teacherPasswordInput').value === TEACHER_PASSWORD) {
                window.closePasswordModal(); window.openDashboard();
            } else {
                document.getElementById('passwordError').classList.remove('hidden');
                document.getElementById('teacherPasswordInput').focus();
            }
        };

        let unsubscribe = null;
        window.openDashboard = function() {
            document.getElementById('dashboardModal').classList.remove('hidden');
            if (auth.currentUser) {
                const resultsRef = collection(db, 'artifacts', appId, 'public', 'data', COLLECTION_NAME);
                unsubscribe = onSnapshot(resultsRef, (snapshot) => {
                    allResults = [];
                    snapshot.forEach(doc => { allResults.push({ id: doc.id, ...doc.data() }); });
                    window.updateFilterOptions();
                    window.renderTable();
                }, (error) => {
                    console.error("대시보드 데이터 로드 에러:", error);
                });
            } else {
                window.customAlert("로그인 정보가 없습니다.");
            }
        };
        window.closeDashboard = function() {
            document.getElementById('dashboardModal').classList.add('hidden');
            if(unsubscribe) { unsubscribe(); unsubscribe = null; }
        };

        window.updateFilterOptions = function() {
            const filter = document.getElementById('classFilter');
            const current = filter.value;
            const unique = [...new Set(allResults.map(i => `${i.grade}-${i.classNum}`))].sort();
            let html = `<option value="all">모든 반 전체 보기</option>`;
            unique.forEach(c => html += `<option value="${c}">${c}반</option>`);
            filter.innerHTML = html;
            if(unique.includes(current)) filter.value = current;
        };

        window.toggleHistory = function(histClass) {
            const rows = document.querySelectorAll('.' + histClass);
            rows.forEach(r => r.classList.toggle('hidden'));
        };

        window.renderTable = function() {
            const tbody = document.getElementById('dashboardTableBody');
            const filter = document.getElementById('classFilter').value;
            const totalCount = parseInt(document.getElementById('totalStudentCount').value) || 30;
            
            let data = filter === 'all' ? allResults : allResults.filter(i => `${i.grade}-${i.classNum}` === filter);
            
            if(data.length === 0) { 
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-gray-500">제출된 기록이 없습니다.</td></tr>`; 
                document.getElementById('missingStudents').innerHTML = `제출 내역이 없습니다.`;
                return; 
            }

            const studentMap = {};
            data.forEach(item => {
                const sNum = parseInt(item.studentNum) || item.studentNum;
                const groupKey = `${item.grade}-${item.classNum}-${sNum}`;
                if(!studentMap[groupKey]) studentMap[groupKey] = [];
                studentMap[groupKey].push(item);
            });

            Object.keys(studentMap).forEach(key => {
                studentMap[key].sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
            });

            const missingDiv = document.getElementById('missingStudents');
            if (filter !== 'all') {
                const submittedNums = Object.values(studentMap).map(arr => parseInt(arr[0].studentNum)).filter(n => !isNaN(n));
                const missing = [];
                for(let i=1; i<=totalCount; i++) {
                    if(!submittedNums.includes(i)) missing.push(i);
                }
                if(missing.length === 0) {
                    missingDiv.innerHTML = `<span class="text-green-600"><i class="fa-solid fa-check-circle"></i> 전원 제출 완료!</span>`;
                    missingDiv.className = "text-green-600 font-bold bg-green-50 px-3 py-1 rounded-lg border border-green-200 shadow-sm text-sm";
                } else {
                    missingDiv.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> 미제출 번호: ${missing.join(', ')}`;
                    missingDiv.className = "text-rose-600 font-bold bg-rose-50 px-3 py-1 rounded-lg border border-rose-200 shadow-sm text-sm";
                }
            } else {
                missingDiv.innerHTML = `<span class="text-gray-500">특정 반을 선택하면 미제출자를 확인할 수 있습니다.</span>`;
                missingDiv.className = "text-gray-600 font-bold bg-gray-50 px-3 py-1 rounded-lg border border-gray-200 shadow-sm text-sm";
            }

            const sortedGroups = Object.values(studentMap).sort((groupA, groupB) => {
                const aNum = parseInt(groupA[0].studentNum) || 999;
                const bNum = parseInt(groupB[0].studentNum) || 999;
                return aNum - bNum;
            });

            const renderCell = (mode, cellData) => {
                if(mode === 'draw' && cellData && cellData.startsWith('data:image')) {
                    return `<img src="${cellData}" class="h-20 w-auto object-contain border border-gray-300 bg-white rounded cursor-zoom-in hover:scale-[3] origin-left transition-transform shadow-sm" alt="손글씨" />`;
                } else {
                    const text = cellData || '-';
                    const trunc = text.length > 50 ? text.substring(0,50)+'...' : text;
                    return `<div class="text-sm text-gray-700 whitespace-pre-wrap" title="${text}">${trunc}</div>`;
                }
            };

            const formatTime = (isoString) => {
                const d = new Date(isoString);
                return `${d.getMonth()+1}/${d.getDate()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
            };

            tbody.innerHTML = '';
            
            sortedGroups.forEach(group => {
                const latest = group[0]; 
                const hasHistory = group.length > 1;
                const histClass = `hist-${latest.id}`;
                
                let scoreColor = latest.quizScore === 7 ? "text-blue-600" : "text-amber-600";
                const refHtml = `
                    <div class="text-xs text-rose-700 mb-1"><b>[후회]</b><br>${renderCell(latest.exp_regret_mode, latest.exp_regret)}</div>
                    <div class="text-xs text-blue-700"><b>[만족]</b><br>${renderCell(latest.exp_satisfy_mode, latest.exp_satisfy)}</div>
                `;

                tbody.innerHTML += `
                    <tr class="hover:bg-amber-50 transition border-b-2 border-stone-200">
                        <td class="p-3 text-center font-bold text-lg text-stone-700">${latest.classNum}-${latest.studentNum}</td>
                        <td class="p-3 font-bold text-stone-900 text-lg">${latest.studentName}</td>
                        <td class="p-3">${refHtml}</td>
                        <td class="p-3 text-center font-bold text-amber-800 bg-amber-50 rounded-lg m-1">${latest.food_choice || '-'}</td>
                        <td class="p-3">${renderCell(latest.reason_mode, latest.reason)}</td>
                        <td class="p-3 text-center font-bold ${scoreColor} text-lg">${latest.quizScore} / 7</td>
                        <td class="p-3 text-center">
                            <div class="text-xs font-bold text-blue-600 bg-blue-50 py-1 rounded-md mb-1 border border-blue-200">최종본</div>
                            <div class="text-xs text-gray-500 flex justify-center items-center gap-2">
                                ${formatTime(latest.timestamp)}
                                <button onclick="window.deleteSubmission('${latest.id}')" class="text-rose-400 hover:text-rose-600 transition p-1" title="삭제"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                            ${hasHistory ? `<button onclick="window.toggleHistory('${histClass}')" class="mt-2 text-xs bg-stone-200 hover:bg-stone-300 text-stone-700 py-1 px-2 rounded font-bold w-full transition">과거 기록 (${group.length-1}건) ▼</button>` : ''}
                        </td>
                    </tr>
                `;

                if (hasHistory) {
                    for(let i = 1; i < group.length; i++) {
                        const past = group[i];
                        let pScoreColor = past.quizScore === 7 ? "text-blue-500" : "text-amber-500";
                        const pRefHtml = `
                            <div class="text-xs text-rose-600 mb-1"><b>[후회]</b><br>${renderCell(past.exp_regret_mode, past.exp_regret)}</div>
                            <div class="text-xs text-blue-600"><b>[만족]</b><br>${renderCell(past.exp_satisfy_mode, past.exp_satisfy)}</div>
                        `;
                        
                        tbody.innerHTML += `
                            <tr class="${histClass} hidden history-row border-b border-gray-200 text-sm">
                                <td class="p-3 text-center text-gray-400">↪</td>
                                <td class="p-3 text-gray-500">${past.studentName}</td>
                                <td class="p-3">${pRefHtml}</td>
                                <td class="p-3 text-center text-gray-500">${past.food_choice || '-'}</td>
                                <td class="p-3">${renderCell(past.reason_mode, past.reason)}</td>
                                <td class="p-3 text-center ${pScoreColor}">${past.quizScore} / 7</td>
                                <td class="p-3 text-center text-xs text-gray-400">
                                    과거 제출본<br>
                                    <div class="flex justify-center items-center gap-2 mt-1">
                                        ${formatTime(past.timestamp)}
                                        <button onclick="window.deleteSubmission('${past.id}')" class="text-rose-300 hover:text-rose-500 transition p-1" title="삭제"><i class="fa-solid fa-trash-can"></i></button>
                                    </div>
                                </td>
                            </tr>
                        `;
                    }
                }
            });
        };

        window.downloadCSV = function() {
            const filter = document.getElementById('classFilter').value;
            let data = filter === 'all' ? allResults : allResults.filter(i => `${i.grade}-${i.classNum}` === filter);
            if(data.length===0) { window.customAlert("다운로드할 데이터가 없습니다."); return; }

            data.sort((a, b) => {
                const numA = parseInt(a.studentNum) || 999;
                const numB = parseInt(b.studentNum) || 999;
                if(numA !== numB) return numA - numB;
                return new Date(b.timestamp) - new Date(a.timestamp);
            });

            let csv = "\uFEFF제출일시,학년,반,번호,이름,후회한경험,만족한경험,음식선택,선택기준,퀴즈점수\n";
            data.forEach(i => {
                const d = new Date(i.timestamp);
                const t = `${d.getMonth()+1}/${d.getDate()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
                
                const getContent = (mode, val) => mode === 'draw' ? "[손글씨 그림]" : (val || "");
                const regretVal = getContent(i.exp_regret_mode, i.exp_regret);
                const satisfyVal = getContent(i.exp_satisfy_mode, i.exp_satisfy);
                const reasonVal = getContent(i.reason_mode, i.reason);

                const escapeCsv = (str) => `"${String(str).replace(/"/g, '""').replace(/\n/g, ' ')}"`;
                
                csv += `${escapeCsv(t)},${escapeCsv(i.grade)},${escapeCsv(i.classNum)},${escapeCsv(i.studentNum)},${escapeCsv(i.studentName)},${escapeCsv(regretVal)},${escapeCsv(satisfyVal)},${escapeCsv(i.food_choice)},${escapeCsv(reasonVal)},${i.quizScore}\n`;
            });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
            link.download = `사회_합리적선택_${filter==='all'?'전체':filter+'반'}_결과.csv`;
            link.click();
        };
    </script>
</body>
</html>
