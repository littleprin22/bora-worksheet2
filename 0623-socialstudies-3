<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>우리나라 특산물 지도 퀴즈 20문항</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Pretendard", "Noto Sans KR", Arial, sans-serif;
      background: linear-gradient(180deg, #eef7ff 0%, #f8fbff 100%);
      color: #1f2937;
    }
    .wrap { max-width: 1480px; margin: 0 auto; padding: 18px; }
    .header {
      background: white;
      border-radius: 24px;
      padding: 20px 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      margin-bottom: 18px;
    }
    h1 { margin: 0 0 8px; font-size: 30px; }
    .subtitle { font-size: 16px; color: #4b5563; line-height: 1.65; }
    .topbar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
      margin-top: 16px;
    }
    .scoreboard { display: flex; gap: 12px; flex-wrap: wrap; }
    .pill {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 999px;
      padding: 10px 14px;
      font-weight: 700;
    }
    .btns { display: flex; gap: 10px; flex-wrap: wrap; }
    button {
      border: none;
      border-radius: 14px;
      padding: 12px 16px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s ease;
    }
    button:hover { transform: translateY(-1px); }
    .primary { background: #2563eb; color: white; }
    .secondary { background: #e5e7eb; color: #111827; }
    .accent { background: #10b981; color: white; }
    .main {
      display: grid;
      grid-template-columns: minmax(340px, 1fr) 430px;
      gap: 18px;
    }
    .map-panel, .card-panel {
      background: white;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }
    .panel-title {
      padding: 18px 20px;
      font-size: 22px;
      font-weight: 800;
      border-bottom: 1px solid #eef2f7;
      background: #fcfdff;
    }
    .map-area { padding: 18px; }
    .map-container {
      position: relative;
      width: 100%;
      max-width: 930px;
      margin: 0 auto;
      aspect-ratio: 812 / 758;
      border-radius: 20px;
      overflow: hidden;
      border: 2px solid #dbeafe;
      background: #d9ecf8;
    }
    .map-container img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      user-select: none;
      pointer-events: none;
    }
    .drop-zone {
      position: absolute;
      width: 76px;
      min-height: 46px;
      border: 3px dashed rgba(37, 99, 235, 0.62);
      border-radius: 14px;
      background: rgba(255,255,255,0.86);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4px;
      font-size: 11px;
      font-weight: 800;
      color: #1d4ed8;
      transition: 0.2s ease;
      line-height: 1.2;
    }
    .drop-zone.over {
      transform: scale(1.04);
      background: rgba(219,234,254,0.96);
      border-color: #1d4ed8;
    }
    .drop-zone.correct {
      border-style: solid;
      border-color: #16a34a;
      background: rgba(220,252,231,0.97);
      color: #166534;
    }
    .drop-zone.wrong {
      animation: shake 0.25s linear 2;
      border-color: #dc2626;
      background: rgba(254,226,226,0.97);
      color: #991b1b;
    }
    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      50% { transform: translateX(4px); }
      75% { transform: translateX(-4px); }
      100% { transform: translateX(0); }
    }
    .card-panel-body { padding: 18px; }
    .guide {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 14px;
      border-radius: 16px;
      line-height: 1.7;
      margin-bottom: 14px;
      font-size: 15px;
    }
    .cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      max-height: 780px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .drag-card {
      background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
      border: 2px solid #dbeafe;
      border-radius: 18px;
      padding: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: grab;
      box-shadow: 0 4px 12px rgba(37,99,235,0.08);
      user-select: none;
    }
    .drag-card:active { cursor: grabbing; }
    .emoji {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      background: #eff6ff;
      flex-shrink: 0;
    }
    .card-text strong { display: block; font-size: 17px; margin-bottom: 3px; }
    .card-text span { color: #6b7280; font-size: 13px; }
    .message {
      margin-top: 14px;
      min-height: 54px;
      border-radius: 16px;
      padding: 14px;
      font-weight: 700;
      line-height: 1.6;
      background: #f8fafc;
      border: 1px solid #e5e7eb;
    }
    .message.success { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
    .message.error { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
    .message.info { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .footer-note {
      margin-top: 16px;
      color: #6b7280;
      font-size: 14px;
      line-height: 1.7;
    }
    @media (max-width: 1080px) {
      .main { grid-template-columns: 1fr; }
      .cards { max-height: none; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <h1>우리나라 특산물 지도 퀴즈</h1>
      <div class="subtitle">
        지도 이미지가 파일 안에 <strong>직접 포함된</strong> 버전입니다. 특산물 카드를 끌어서 알맞은 지역 상자에 놓아 보세요.
      </div>
      <div class="topbar">
        <div class="scoreboard">
          <div class="pill">맞힌 개수: <span id="correctCount">0</span> / 20</div>
          <div class="pill">남은 카드: <span id="remainingCount">20</span></div>
        </div>
        <div class="btns">
          <button class="secondary" id="hintBtn">힌트 보기</button>
          <button class="accent" id="showAnswerBtn">정답 보기</button>
          <button class="primary" id="resetBtn">다시 하기</button>
        </div>
      </div>
    </div>

    <div class="main">
      <section class="map-panel">
        <div class="panel-title">지도에서 지역을 찾아보세요</div>
        <div class="map-area">
          <div class="map-container" id="mapContainer">
            <img src="data:image/png;base64," alt="우리나라 지역 특산물 지도" />
            <div class="drop-zone" data-answer="오징어" style="left:77%; top:8%;">속초</div>
<div class="drop-zone" data-answer="송이" style="left:83%; top:15%;">양양</div>
<div class="drop-zone" data-answer="호박엿" style="left:88%; top:9%;">홍천</div>
<div class="drop-zone" data-answer="황태" style="left:58%; top:20%;">평창</div>
<div class="drop-zone" data-answer="한우" style="left:52%; top:26%;">횡성</div>
<div class="drop-zone" data-answer="옥수수" style="left:71%; top:31%;">정선</div>
<div class="drop-zone" data-answer="시멘트" style="left:80%; top:24%;">삼척</div>
<div class="drop-zone" data-answer="쌀" style="left:41%; top:31%;">이천</div>
<div class="drop-zone" data-answer="도자기" style="left:34%; top:27%;">여주</div>
<div class="drop-zone" data-answer="사과" style="left:48%; top:39%;">충주</div>
<div class="drop-zone" data-answer="마늘" style="left:59%; top:39%;">단양</div>
<div class="drop-zone" data-answer="인삼" style="left:36%; top:46%;">금산</div>
<div class="drop-zone" data-answer="참외" style="left:58%; top:57%;">성주</div>
<div class="drop-zone" data-answer="대게" style="left:79%; top:53%;">영덕</div>
<div class="drop-zone" data-answer="과메기" style="left:76%; top:60%;">포항</div>
<div class="drop-zone" data-answer="한지" style="left:31%; top:67%;">전주</div>
<div class="drop-zone" data-answer="배" style="left:22%; top:78%;">나주</div>
<div class="drop-zone" data-answer="녹차" style="left:39%; top:77%;">보성</div>
<div class="drop-zone" data-answer="감귤" style="left:80%; top:89%;">제주</div>
<div class="drop-zone" data-answer="흑돼지" style="left:88%; top:89%;">제주</div>
          </div>
        </div>
      </section>

      <aside class="card-panel">
        <div class="panel-title">특산물 카드</div>
        <div class="card-panel-body">
          <div class="guide">
            <strong>활동 방법</strong><br>
            1. 특산물 카드를 끌어요.<br>
            2. 지도 위 알맞은 지역 상자에 놓아요.<br>
            3. 정답이면 상자가 초록색으로 바뀌고 카드가 고정돼요.
          </div>

          <div class="cards" id="cardList"></div>
          <div class="message info" id="messageBox">문제를 20개로 늘렸고, 지도도 꼭 보이도록 파일 안에 넣었습니다.</div>
          <div class="footer-note">
            이 파일은 이미지가 분리되어 있지 않은 단일 HTML 파일입니다. 다른 컴퓨터로 옮겨도 지도 이미지가 함께 보입니다.
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    const initialItems = [{"id": "jeju_pork", "name": "흑돼지", "emoji": "🐷", "region": "제주", "hint": "제주를 대표하는 축산 특산물이에요.", "left": "88%", "top": "89%"}, {"id": "jeongseon_corn", "name": "옥수수", "emoji": "🌽", "region": "정선", "hint": "강원도 산간 지역의 대표 농산물이에요.", "left": "71%", "top": "31%"}, {"id": "pohang_gwamegi", "name": "과메기", "emoji": "🐠", "region": "포항", "hint": "경상북도 동해안 도시의 대표 먹거리예요.", "left": "76%", "top": "60%"}, {"id": "hoengseong_beef", "name": "한우", "emoji": "🐮", "region": "횡성", "hint": "강원도 내륙의 대표 소고기 특산물이에요.", "left": "52%", "top": "26%"}, {"id": "chungju_apple", "name": "사과", "emoji": "🍎", "region": "충주", "hint": "충청북도의 대표 과일이에요.", "left": "48%", "top": "39%"}, {"id": "yeongdeok_crab", "name": "대게", "emoji": "🦀", "region": "영덕", "hint": "동해안의 대표 바다 특산물이에요.", "left": "79%", "top": "53%"}, {"id": "jeonju_hanji", "name": "한지", "emoji": "📜", "region": "전주", "hint": "전라북도의 전통 공예 특산물이에요.", "left": "31%", "top": "67%"}, {"id": "jeju_tangerine", "name": "감귤", "emoji": "🍊", "region": "제주", "hint": "제주의 대표 과일이에요.", "left": "80%", "top": "89%"}, {"id": "samcheok_cement", "name": "시멘트", "emoji": "🧱", "region": "삼척", "hint": "동해안 쪽의 대표 공업 생산물이어요.", "left": "80%", "top": "24%"}, {"id": "seongju_melon", "name": "참외", "emoji": "🍈", "region": "성주", "hint": "경상북도에서 매우 유명한 달콤한 과일이에요.", "left": "58%", "top": "57%"}, {"id": "boseong_greentea", "name": "녹차", "emoji": "🍵", "region": "보성", "hint": "전라남도의 대표 차 생산지예요.", "left": "39%", "top": "77%"}, {"id": "danyang_garlic", "name": "마늘", "emoji": "🧄", "region": "단양", "hint": "충청북도 북동부 지역의 대표 농산물이에요.", "left": "59%", "top": "39%"}, {"id": "yangyang_mushroom", "name": "송이", "emoji": "🍄", "region": "양양", "hint": "강원도 동해안 지역의 산림 특산물이에요.", "left": "83%", "top": "15%"}, {"id": "geumsan_ginseng", "name": "인삼", "emoji": "🌿", "region": "금산", "hint": "충청남도 남동부 지역의 대표 특산물이에요.", "left": "36%", "top": "46%"}, {"id": "hongcheon_hobakyeot", "name": "호박엿", "emoji": "🍬", "region": "홍천", "hint": "강원도 내륙 지역의 달콤한 특산물이에요.", "left": "88%", "top": "9%"}, {"id": "naju_pear", "name": "배", "emoji": "🍐", "region": "나주", "hint": "전라남도의 대표 과일이에요.", "left": "22%", "top": "78%"}, {"id": "icheon_rice", "name": "쌀", "emoji": "🌾", "region": "이천", "hint": "경기도의 대표 쌀 생산지예요.", "left": "41%", "top": "31%"}, {"id": "yeoju_ceramic", "name": "도자기", "emoji": "🏺", "region": "여주", "hint": "경기도의 전통 공예 특산물이에요.", "left": "34%", "top": "27%"}, {"id": "sokcho_squid", "name": "오징어", "emoji": "🦑", "region": "속초", "hint": "강원도 동해안 북쪽 지역의 바다 특산물이에요.", "left": "77%", "top": "8%"}, {"id": "pyeongchang_hwangtae", "name": "황태", "emoji": "🐟", "region": "평창", "hint": "강원도 산간 지역에서 유명한 건어물이에요.", "left": "58%", "top": "20%"}];
    const TOTAL = initialItems.length;

    const state = {
      items: JSON.parse(JSON.stringify(initialItems)),
      solved: 0
    };

    const cardList = document.getElementById('cardList');
    const messageBox = document.getElementById('messageBox');
    const correctCount = document.getElementById('correctCount');
    const remainingCount = document.getElementById('remainingCount');
    const dropZones = [...document.querySelectorAll('.drop-zone')];
    const hintBtn = document.getElementById('hintBtn');
    const showAnswerBtn = document.getElementById('showAnswerBtn');
    const resetBtn = document.getElementById('resetBtn');

    function renderCards() {
      cardList.innerHTML = '';
      state.items.forEach(item => {
        const card = document.createElement('div');
        card.className = 'drag-card';
        card.draggable = true;
        card.innerHTML = `
          <div class="emoji">${item.emoji}</div>
          <div class="card-text">
            <strong>${item.name}</strong>
            <span>${item.region}을(를) 찾아 놓아 보세요.</span>
          </div>
        `;
        card.addEventListener('dragstart', e => {
          e.dataTransfer.setData('text/plain', JSON.stringify(item));
        });
        cardList.appendChild(card);
      });
      updateScore();
    }

    function updateScore() {
      correctCount.textContent = state.solved;
      remainingCount.textContent = state.items.length;
    }

    function setMessage(text, type='info') {
      messageBox.className = `message ${type}`;
      messageBox.textContent = text;
    }

    function removeCardByName(name) {
      state.items = state.items.filter(item => item.name !== name);
      renderCards();
    }

    function completeZone(zone, item) {
      zone.classList.remove('wrong', 'over');
      zone.classList.add('correct');
      zone.innerHTML = `<div>${zone.dataset.label}<br>${item.emoji} ${item.name}</div>`;
      zone.dataset.locked = 'true';
      state.solved += 1;
      removeCardByName(item.name);
      setMessage(`정답! ${zone.dataset.label}의 특산물은 ${item.name}예요.`, 'success');
      if (state.solved === TOTAL) {
        setMessage('모두 맞혔어요. 우리나라 여러 지역의 특산물을 잘 익혔네요.', 'success');
      }
    }

    dropZones.forEach(zone => {
      zone.dataset.label = zone.textContent.trim();

      zone.addEventListener('dragover', e => {
        if (zone.dataset.locked === 'true') return;
        e.preventDefault();
        zone.classList.add('over');
      });

      zone.addEventListener('dragleave', () => {
        zone.classList.remove('over');
      });

      zone.addEventListener('drop', e => {
        if (zone.dataset.locked === 'true') return;
        e.preventDefault();
        zone.classList.remove('over');
        const raw = e.dataTransfer.getData('text/plain');
        if (!raw) return;
        const item = JSON.parse(raw);

        if (item.name === zone.dataset.answer) {
          completeZone(zone, item);
        } else {
          zone.classList.remove('wrong');
          void zone.offsetWidth;
          zone.classList.add('wrong');
          setMessage(`다시 생각해 보세요. ${item.name}은(는) ${zone.dataset.label}의 특산물이 아니에요.`, 'error');
        }
      });
    });

    hintBtn.addEventListener('click', () => {
      const remaining = state.items;
      if (!remaining.length) {
        setMessage('이미 모두 맞혔어요.', 'success');
        return;
      }
      const hint = remaining[Math.floor(Math.random() * remaining.length)];
      setMessage(`힌트: ${hint.name} — ${hint.hint}`, 'info');
    });

    showAnswerBtn.addEventListener('click', () => {
      setMessage('정답: 속초-오징어, 양양-송이, 홍천-호박엿, 평창-황태, 횡성-한우, 정선-옥수수, 삼척-시멘트, 이천-쌀, 여주-도자기, 충주-사과, 단양-마늘, 금산-인삼, 성주-참외, 영덕-대게, 포항-과메기, 전주-한지, 나주-배, 보성-녹차, 제주-감귤, 제주-흑돼지', 'info');
    });

    resetBtn.addEventListener('click', () => {
      state.items = JSON.parse(JSON.stringify(initialItems));
      state.solved = 0;
      dropZones.forEach(zone => {
        zone.className = 'drop-zone';
        zone.dataset.locked = 'false';
        zone.innerHTML = zone.dataset.label;
      });
      renderCards();
      setMessage('새로 시작합니다. 다시 도전해 보세요.', 'info');
    });

    renderCards();
  </script>
</body>
</html>
